# Copy this file to `.env.e2e` (gitignored) and fill in real values.

# Base URL of the Blocks Data app under test.
#
# Remote dev (default, nothing to run locally):
#   E2E_BASE_URL=https://dev-data.blocksdevelopers.com
#   E2E_NO_WEBSERVER=1
#
# Local build served by the .NET host on API_PORT (5000, see run.sh), reached
# through the named domain — requires a hosts entry pointing it at 127.0.0.1:
#   127.0.0.1 dev-data.blocksdevelopers.com
#   E2E_BASE_URL=https://dev-data.blocksdevelopers.com:5000
E2E_BASE_URL=https://dev-data.blocksdevelopers.com

# Blocks OS host for project delete (defaults from E2E_BASE_URL: dev-data → dev-os).
# E2E_OS_BASE_URL=https://dev-os.blocksdevelopers.com

# Dev-IAM test account credentials (captcha is disabled on dev).
E2E_USERNAME=
E2E_PASSWORD=

# Reuse an existing project instead of creating Test Project * each run.
# E2E_REUSE_PROJECT_NAME=test

# Open a project by UUID (/app/{id}/dashboard) — skips console card search.
# E2E_PROJECT_ID=

# Keep the shared project after the run (also kept automatically on failure).
# E2E_KEEP_PROJECT=1

# Set to 1 to skip auto-starting the app (you manage the server yourself, or
# you are testing the remote dev host). Required for the remote-dev setup
# above — otherwise Playwright boots a local API via `run.sh -b`.
E2E_NO_WEBSERVER=1

# Pause after each test so the end state is watchable. Defaults to 10000 in
# headed mode and 0 when headless; set a value to override either way.
# E2E_PAUSE_MS=10000

# Milliseconds of delay per action, to watch the steps themselves.
# E2E_SLOWMO=600
