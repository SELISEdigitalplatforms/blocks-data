# Exposed via `envPrefix: ['BLOCKS_']` in vite.config (access via `import.meta.env.BLOCKS_*`).
# Copy to `.env` and set values. Restart `npm run dev` after changes.
BLOCKS_API_BASE_URL=
BLOCKS_NOTIFICATION_BASE_URL=
# Optional. When unset, resolved automatically per environment:
#   dev        -> https://dev-api.blocksdevelopers.com
#   stg        -> https://stg-api.blocksdevelopers.com
#   prod       -> https://api.seliseblocks.com
#   (others)   -> falls back to the dev origin above
# BLOCKS_GRAPHQL_GATEWAY_ORIGIN=
BLOCKS_UTILITY_API_ORIGIN=
BLOCKS_X_BLOCKS_KEY=
BLOCKS_GOOGLE_SITE_KEY=
BLOCKS_CONSTRUCT_URL=

# ---------------------------------------------------------------------------
# Local HTTPS (frontend dev server + .NET backend)
# ---------------------------------------------------------------------------
# These are NOT set here. They are MACHINE / USER environment variables, read
# directly from the OS (not BLOCKS_-prefixed, not loaded from this .env):
#
#   DATA_SSL_CERT = absolute path to an mkcert cert PEM
#   DATA_SSL_KEY  = absolute path to the matching key PEM
#
# Rule (frontend + backend): both set AND both files exist -> HTTPS on
# https://dev-data.blocksdevelopers.com (FE :4000, API :5000);
# otherwise HTTP. Never hard-fails.

