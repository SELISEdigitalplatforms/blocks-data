<Project Sdk="Microsoft.NET.Sdk">

<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<Version>9.0.0-preview.2</Version>
		<PackageId>SeliseBlocks.DataGateway.Driver</PackageId>
		<Authors>SeliseBlocks</Authors>
		<Company>SeliseBlocks</Company>
		<Description>Blocks Data Gateway Driver</Description>
    	<IncludeBuildOutput>true</IncludeBuildOutput>
    	<IncludeOutputAssemblies>true</IncludeOutputAssemblies>    
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
    	<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>Genesis, BlocksGenesis, SeliseBlocksGenesis, DataGateway, GraphQL, Driver</PackageTags>
		<RepositoryUrl>https://github.com/SELISEdigitalplatforms/l2-net-blocks-graphql</RepositoryUrl>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

  	<ItemGroup>
    	<ProjectReference Include="../DataGateway.DomainService/DataGateway.DomainService.csproj" />
  	</ItemGroup>
  	

  	<PropertyGroup>
    	<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>
	<ItemGroup>
    	<None Include="README.md" Pack="true" PackagePath="." />
	</ItemGroup>

</Project>
