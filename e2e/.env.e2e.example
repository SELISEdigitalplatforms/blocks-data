# Copy this file to `.env.e2e` (gitignored) and fill in real values.

# Base URL of the running Blocks Data app, served on your named domain.
# Requires a hosts entry pointing that domain at 127.0.0.1, e.g.
#   127.0.0.1 dev-data.blocksdevelopers.com
# Without it the tests hit the remote dev server instead of your machine.
E2E_BASE_URL=https://dev-data.blocksdevelopers.com:5000

# Dev-IAM test account credentials (captcha is disabled on dev).
E2E_USERNAME=
E2E_PASSWORD=

# Set to 1 to skip auto-starting the app (you manage the server yourself).
# E2E_NO_WEBSERVER=1

# Pause after each test so the end state is watchable. Defaults to 10000 in
# headed mode and 0 when headless; set a value to override either way.
# E2E_PAUSE_MS=10000

# Milliseconds of delay per action, to watch the steps themselves.
# E2E_SLOWMO=600
