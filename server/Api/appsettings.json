{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "DatagatewayClusterNames": "aks-blocks-prod",
  "DatagatewayClusterRevision": "prod",
  "AiCompletionUrl": "https://api.openai.com/v1/chat/completions",
  "ChatGptTemperature": "0.1",
  "SwaggerOptions": {
    "Version": "v1",
    "Title": "Blocks Data API",
    "Description": "Blocks Data API documentation",
    "EnableBearerAuth": true,
    "EndpointUrl": "v1/swagger.json",
    "XmlCommentsFilePath": "Blocks.Data.Api.xml",
    "ServiceName": "blocks-data"
  }

  // Origins the SPA needs that no FrontendRuntime key describes. Everything else in the
  // CSP is derived from FrontendRuntime, so it follows the environment automatically.
  // Space- or comma-separated; set per environment via Csp__ExtraConnectSrc / Csp__ExtraImgSrc
  // (Rollbar, CDN and the environment's storage host for presigned uploads).
}